programa {
  funcao inicio() {
    inteiro num

    escreva("Digite um número")
    leia(num)
    
    se(num==1){
      escreva("Domingo")
      }
      senao se(num==2){
        escreva("Segunda")
      }
      senao se(num==3){
        escreva("Terça Feira")
      }
      senao se(num==4){
        escreva("Quarta Feira")
      }
      senao se(num==5){
        escreva("Quinta Feira")
      }
      senao se(num==6){
        escreva("Sexta Feira")
      }
      senao se(num==7){
        escreva("Sabádo")
      }

      senao{
        escreva("Dia Inválido")
      }
      
      }
      }
    
